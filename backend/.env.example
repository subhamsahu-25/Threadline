# Template only — copy to backend/.env and fill in what you need.
# backend/.env is gitignored; never commit real credentials.

# Server
NODE_ENV=development
PORT=4000

# Database — leave MONGODB_URI empty in development to use an ephemeral
# in-memory MongoDB. DB_NAME overrides the database name in the URI.
MONGODB_URI=
DB_NAME=Threadline

# Auth — required in production (the server refuses to start with the dev default)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
# Failed sign-ins before a temporary lockout (minimum 3) and its duration.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Registration policy. Production defaults to invite-only; open is a demo
# affordance. Comma-separated codes/domains narrow it further.
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODES=
REGISTRATION_EMAIL_DOMAINS=

# CORS: comma-separated origins. Production refuses to start when empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Extraction — without a key the deterministic labelled-line extractor is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
EXTRACT_CONCURRENCY=3
EXTRACT_TIME_BUDGET_MS=120000

# Connectors (opt-in). An empty allowlist disables the connector; the shared
# provider token only ever reads references listed here.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=owner/repo,owner/other-repo
GOOGLE_DRIVE_ACCESS_TOKEN=
# Optional OAuth refresh flow. With a client ID, secret and refresh token the
# connector renews the one-hour access token automatically.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
DRIVE_ALLOWED_FOLDERS=
MAX_CONNECTOR_SOURCES=10

# Storage
UPLOAD_DIR=
MAX_UPLOAD_MB=15
MAX_FILES_PER_UPLOAD=20
# Characters of parsed text kept per document. Anything beyond this is dropped
# with a visible warning; the analysis window (250 chunks) is smaller anyway.
MAX_DOCUMENT_CHARS=1000000
# Removes upload files no source references (boot + interval). Files newer than
# UPLOAD_ORPHAN_HOURS are left alone.
UPLOAD_JANITOR_ENABLED=true
UPLOAD_JANITOR_INTERVAL_HOURS=6
UPLOAD_ORPHAN_HOURS=24

# Domain rules
STALE_DAYS=30
# Open questions older than this count against readiness (default 14 days).
OLD_QUESTION_DAYS=14
SHARE_TTL_DAYS=7

# Readiness penalties, in points off a 100-point score. Caps apply per
# category (unverified 30, ownership gap 24, conflict 30, old question 16).
READINESS_PENALTY_UNVERIFIED=3
READINESS_PENALTY_OWNERSHIP_GAP=8
READINESS_PENALTY_CONFLICT=10
READINESS_PENALTY_OLD_QUESTION=4

# Outbound delivery (optional). Without a URL the product records a "skipped"
# delivery row on the handover page instead of pretending a message was sent.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TIMEOUT_MS=5000
HANDOVER_REMINDER_ENABLED=true
HANDOVER_REMINDER_DAYS=3

# Demo. Seeding is off unless ALLOW_DEMO_SEED=true (development/test), and a
# production deployment additionally requires DEMO_MODE=true.
DEMO_MODE=false
ALLOW_DEMO_SEED=true

# Background worker
INGEST_CONCURRENCY=2

# Logging
LOG_LEVEL=info
