# Server
NODE_ENV=development
PORT=4000

# Database
# Leave empty in development to use an ephemeral in-memory MongoDB.
# Set an Atlas connection string for persistence.
MONGODB_URI=

# Auth (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS: comma separated origins. Empty means reflect the request origin (dev only).
CORS_ORIGINS=

# Extraction
# Without a key Threadline uses its deterministic, labelled-line extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Integrations (optional)
GITHUB_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Storage
UPLOAD_DIR=
MAX_UPLOAD_MB=15
MAX_FILES_PER_UPLOAD=20

# Domain rules
STALE_DAYS=30
SHARE_TTL_DAYS=7

# Demo
ALLOW_DEMO_SEED=true

# Background worker
INGEST_CONCURRENCY=2

# Logging
LOG_LEVEL=info
